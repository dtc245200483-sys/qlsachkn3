# Cấu hình môi trường — BẢN MẪU (không chứa giá trị thật)
# Copy thành .env và điền giá trị thật trước khi chạy.

# Kết nối SQL Server (Windows Authentication)
DATABASE_URL=mssql+pyodbc://@localhost\INSTANCE_NAME/LibraryDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# Khóa ký JWT — ĐỔI THÀNH CHUỖI BÍ MẬT
JWT_SECRET=change-me-to-a-long-random-secret

# Thời hạn token (phút)
JWT_EXPIRE_MINUTES=480

# CORS (dấu * = cho phép tất cả khi chạy local)
CORS_ORIGINS=*
